{
  "name": "snifftok-api",
  "version": "0.1.0",
  "description": "snifftok backend API — perfume reselling store",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "seed": "node src/scripts/seedAdmin.js",
    "seed:categories": "node src/scripts/seedCategories.js",
    "seed:all": "npm run seed && npm run seed:categories",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "otpauth": "^9.5.2",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.4",
    "slugify": "^1.6.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.3",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.3"
  }
}
